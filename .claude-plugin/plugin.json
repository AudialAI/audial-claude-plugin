{
  "name": "audial",
  "displayName": "Audial",
  "version": "0.1.1",
  "description": "Stem splitting, mastering, audio-to-MIDI, music generation, resynthesis and vocal synthesis with Audial's hosted engines.",
  "icon": ".claude-plugin/icon.png",
  "author": {
    "name": "Audial",
    "email": "contact@audialmusic.ai",
    "url": "https://audialmusic.ai"
  },
  "homepage": "https://audialmusic.ai/resources/api-reference",
  "repository": "https://github.com/AudialAI/audial-claude-plugin",
  "documentationUrl": "https://www.audialmusic.ai/integrations/mcp-server",
  "supportUrl": "https://www.audialmusic.ai/resources/support",
  "privacyPolicyUrl": "https://www.audialmusic.ai/legal/privacy",
  "termsOfServiceUrl": "https://www.audialmusic.ai/legal/terms",
  "license": "MIT",
  "keywords": [
    "audio",
    "music",
    "stems",
    "mastering",
    "midi"
  ],
  "userConfig": {
    "user_id": {
      "type": "string",
      "title": "Audial user id",
      "description": "From your dashboard at audialmusic.ai",
      "required": true
    },
    "api_key": {
      "type": "string",
      "title": "Audial API key",
      "description": "From your dashboard at audialmusic.ai",
      "sensitive": true,
      "required": true
    },
    "results_dir": {
      "type": "directory",
      "title": "Results folder",
      "description": "Where Audial writes stems, masters, MIDI and generated audio",
      "default": "~/Audial"
    }
  }
}
